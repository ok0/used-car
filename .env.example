# 이 파일을 .env 로 복사해서 사용하세요:  cp .env.example .env
# 실행 시 직접 지정한 환경변수(VAR=값 npx ts-node ...)가 .env 보다 우선합니다.
# 값을 비우거나 줄 앞에 #을 붙이면 기본값이 사용됩니다.

# ── collect: 엔카 시세 API 추가 수집 (기본 꺼짐, 켜면 요청량 크게 증가) ──
# 동급매물 시세 (중앙값, P25/P75 등)
# ENCAR_FETCH_MARKET=1
# 연식별 평균 시세 (가격 점수의 기준으로 사용)
# ENCAR_FETCH_YEARLY=1

# ── compare: 동급매물 선정 조건 ──
# 주행거리 ±% 범위. 콤마로 여러 단계를 주면 표본이 모자랄 때 앞에서부터 넓힘. none 이면 제한 없음 (기본 40,60)
# COMPARE_MILEAGE_RANGE=40,60
# 최초등록 연식 ±N년 (기본 2)
# COMPARE_YEAR_RANGE=2
# 동급 최소 표본 수 (기본 5)
# COMPARE_MIN_SAMPLES=5
# 옵션·사양 보정 상한 % (0이면 끔, 기본 7)
# COMPARE_SPEC_MAX_ADJUST=7
# 헤이딜러 기본 프리미엄 % (0~10 정수, 기본 5)
# COMPARE_PREMIUM_HEYDEALER=5
# 케이카 기본 프리미엄 % (0~10 정수, 기본 5)
# COMPARE_PREMIUM_KCAR=5
# 현대 인증중고차 기본 프리미엄 % (0~10 정수, 기본 5)
# COMPARE_PREMIUM_HYUNDAI_CERTIFIED=5

# ── 미확인(판매 추정) 매물 ──
# 엔카 목록에서 N일 이상 확인되지 않은 매물은 compare 동급·로컬 시세·가격 점수 기준에서 제외하고 purge 삭제 대상이 됩니다.
# 0 이상의 정수 (기본 14). 0이면 끔(모든 매물 사용, purge 불가). 잘못된 값이면 모든 명령이 시작 시 오류로 끝납니다.
# STALE_DAYS=14

# ── GUI 웹 서버 ──
# 포트 번호 (기본 5174)
# GUI_PORT=5174
# 사용할 DB 파일 경로. 지정하면 해당 파일을 읽기 전용으로 사용. 테스트/검증 용도
# USED_CAR_DB=
