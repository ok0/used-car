{
  "name": "used-car",
  "version": "0.1.0",
  "description": "중고차 가격 객관성 검증 도구 (엔카 시세 수집 + 가격 적정성 비교 CLI)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "gui": "vite build web --logLevel warn && ts-node src/server/main.ts",
    "gui:build": "vite build web",
    "gui:typecheck": "tsc -p web",
    "gui:dev": "ts-node src/server/main.ts --dev & vite web"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "fastify": "^5.12.5",
    "@fastify/static": "^10.1.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "^6.1.1"
  }
}
